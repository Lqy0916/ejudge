%><%@set getter_name = "csp_get_cnts_edit_cur_contest_page"
%><%@set ac_prefix = "SSERV_CMD_"
%><%@set err_prefix = "SSERV_ERR_"
%><%@page csp_view_cnts_edit_cur_contest_page(PageInterface *pg, FILE *log_f, FILE *out_f, struct http_request_info *phr)
%><%@include "stdvars.csp"
%><%
    unsigned char subtitle_buf[1024];
    const unsigned char *title = 0;
    const unsigned char *subtitle = subtitle_buf;
    opcap_t caps = 0;
    int row = 1;
    int cur_page = 1;
    int active = 0;

    %><s:read name="active" default="0" ignoreerrors="yes" /><%

static const unsigned char * const form_row_attrs[]=
{
  " bgcolor=\"#d0d0d0\"",
  " bgcolor=\"#e0e0e0\"",
};

    if (phr->priv_level != PRIV_LEVEL_ADMIN) FAIL(SSERV_ERR_PERMISSION_DENIED);
    if (ejudge_cfg_opcaps_find(phr->config, phr->login, &caps) < 0) FAIL(SSERV_ERR_PERMISSION_DENIED);
    if (opcaps_check(caps, OPCAP_EDIT_CONTEST) < 0) FAIL(SSERV_ERR_PERMISSION_DENIED);
    if (!phr->ss->edited_cnts) FAIL(SSERV_ERR_CONTEST_NOT_EDITED);

    snprintf(subtitle_buf, sizeof(subtitle_buf), "editing contest.xml");
    cnts = phr->ss->edited_cnts;
%><%@include "header_jqgrid.csp"
%>

<script type="text/javascript">
  var SID='<s:v value="phr->session_id" />';
  var self_url='<s:v value="phr->self_url" escape="false" />';
  var script_name='<s:v value="phr->script_name" escape="false" />';
  var current_action=<s:ac ac="cnts-edit-cur-contest-page" />;
</script>

<%@include "cnts_edit_cur_top_menu.csp"
%>

<style type="text/css">
.contest-settings-section { width: 100%; }
.contest-settings-section td:nth-child(1) { width: 34%; }
.contest-settings-section td:nth-child(2) { width: 60%; }
.contest-settings-section input[type="text"],
.contest-settings-section select { box-sizing: border-box; max-width: 100%; }
#ContestSettingsStatus { margin: 8px 0; white-space: pre-line; }
#ContestSettingsStatus.is-error { color: #a40000; font-weight: bold; }
.contest-file-editor { margin-left: 8px; white-space: nowrap; }
.contest-setting-error { outline: 2px solid #c00; }
</style>

<s:form id="ContestSettingsForm">
    <s:hidden name="action" ac="cnts-save-contest-form" />
</s:form>

<script type="text/javascript">
var contestSettingsDirty = false;
var contestSettingsSaving = false;
var contestSettingsTimer = null;
var contestSettingsSavedData = null;
var contestSettingsContinue = null;
var contestSettingsDiscard = false;
var contestSettingsActivating = false;

function contestSettingsControls()
{
    return $(".contest-settings-section").find(":input[name]").not(":button");
}

function serializeContestSettings()
{
    var formData = $("#ContestSettingsForm").serialize();
    var settingsData = contestSettingsControls().serialize();
    return formData + (formData && settingsData ? "&" : "") + settingsData;
}

function setContestSettingsStatus(message, state)
{
    $("#ContestSettingsStatus").toggleClass("is-error", state === "error")
        .text(String(message).replace(/<br\s*\/?\s*>/gi, "\n"));
}

function markContestSettingsDirty()
{
    contestSettingsDirty = serializeContestSettings() !== contestSettingsSavedData;
    clearTimeout(contestSettingsTimer);
    if (contestSettingsDirty) {
        contestSettingsTimer = setTimeout(saveContestSettings, 700);
    }
}

function activateContestSettings(index)
{
    contestSettingsActivating = true;
    $("#ContestAccordion").accordion("option", "active", index);
    contestSettingsActivating = false;
}

function continueContestSettings()
{
    var continuation = contestSettingsContinue;
    contestSettingsContinue = null;
    if (continuation) continuation();
}

// Serialize requests: a response must never mark newer input as saved.
function saveContestSettings()
{
    clearTimeout(contestSettingsTimer);
    if (contestSettingsSaving) return;
    if (contestSettingsDiscard) {
        contestSettingsDirty = false;
        continueContestSettings();
        return;
    }
    var snapshot = serializeContestSettings();
    contestSettingsDirty = snapshot !== contestSettingsSavedData;
    if (!contestSettingsDirty) {
        continueContestSettings();
        return;
    }
    contestSettingsSaving = true;
    $(".contest-setting-error").removeClass("contest-setting-error");
    setContestSettingsStatus("Saving to the editing session...", "");
    var succeeded = false;
    $.ajax({
        url: $("#ContestSettingsForm").attr("action"),
        type: "POST",
        dataType: "json",
        data: snapshot,
        timeout: 15000,
        success: function(data) {
            if (!data || data.retval !== 0) {
                setContestSettingsStatus(data && data.messages ? data.messages : "Could not save settings. Edit the highlighted field or try leaving this section again.", "error");
                if (data && data.active >= 0) activateContestSettings(data.active);
                if (data && data.error_field) {
                    $("#ContestSetting_" + data.error_field).addClass("contest-setting-error").focus();
                }
                return;
            }
            succeeded = true;
            contestSettingsSavedData = snapshot;
            contestSettingsDirty = serializeContestSettings() !== snapshot;
            setContestSettingsStatus("Changes are saved automatically to the editing session. Use COMMIT changes! to apply them.", "");
        },
        error: function(jqXHR, textStatus) {
            var message;
            if (textStatus === "parsererror") {
                message = "The server returned an unexpected response. Your input is still on this page. The editing session may have expired; check the server log before reloading.";
            } else if (jqXHR && jqXHR.status) {
                message = "Could not save settings (HTTP " + jqXHR.status + "). Your input is still on this page. Try leaving this section again.";
            } else {
                message = "Could not reach the server to save settings. Your input is still on this page. Check the connection and try leaving this section again.";
            }
            setContestSettingsStatus(message, "error");
        },
        complete: function() {
            contestSettingsSaving = false;
            if (succeeded || contestSettingsDiscard) {
                saveContestSettings();
            } else {
                clearTimeout(contestSettingsTimer);
                contestSettingsContinue = null;
                if (serializeContestSettings() !== snapshot) {
                    contestSettingsTimer = setTimeout(saveContestSettings, 700);
                }
            }
        }
    });
}

function afterContestSettingsSaved(continuation, discard)
{
    // Keep the first navigation intent while its save is in progress.
    if (contestSettingsContinue) return;
    contestSettingsContinue = continuation;
    contestSettingsDiscard = !!discard;
    saveContestSettings();
}

$(function() {
    $("#ContestAccordion").accordion({
        beforeActivate: function(event, ui) {
            if (contestSettingsActivating) return;
            if (contestSettingsDirty || contestSettingsSaving) {
                event.preventDefault();
                var index = ui.newHeader.length ? $("#ContestAccordion > h3").index(ui.newHeader) : false;
                afterContestSettingsSaved(function() { activateContestSettings(index); });
            }
        },
        heightStyle: "content"<% if (active > 0) { %>,
        active: <s:v value="active" /><% } %>
    });

    $("#ContestSetting_reg_deadline_time").timepicker({ "timeFormat": "H:i", "step": 30 });
    $("#ContestSetting_reg_deadline_date").datepicker({ dateFormat: "yy-mm-dd", firstDay: 1, showButtonPanel: true });
    $("#ContestSetting_sched_time_time").timepicker({ "timeFormat": "H:i", "step": 30 });
    $("#ContestSetting_sched_time_date").datepicker({ dateFormat: "yy-mm-dd", firstDay: 1, showButtonPanel: true });
    $("#ContestSetting_open_time_time").timepicker({ "timeFormat": "H:i", "step": 30 });
    $("#ContestSetting_open_time_date").datepicker({ dateFormat: "yy-mm-dd", firstDay: 1, showButtonPanel: true });
    $("#ContestSetting_close_time_time").timepicker({ "timeFormat": "H:i", "step": 30 });
    $("#ContestSetting_close_time_date").datepicker({ dateFormat: "yy-mm-dd", firstDay: 1, showButtonPanel: true });

    var userContest = $("#ContestSetting_user_contest");
    $.ajax({
        url: self_url,
        data: { SID: SID, action: "<s:ac ac="get-contest-list" />" },
        dataType: "text",
        success: function(data) {
            // Do not replace a selection that the user changed while loading.
            var selection = userContest.val();
            userContest.html(data).val(selection);
            if (userContest.val() === null) {
                userContest.append($("<option>").val(selection).text(selection)).val(selection);
            }
        }
    });

    contestSettingsSavedData = serializeContestSettings();
    contestSettingsControls().on("input change", markContestSettingsDirty);
    contestSettingsControls().on("focusout", function() {
        if (contestSettingsDirty) saveContestSettings();
    });

    // Capture navigation before other handlers can leave the editing page.
    document.addEventListener("click", function(event) {
        var link = $(event.target).closest("a[href]")[0];
        if (!link || link.origin !== window.location.origin ||
            link.pathname !== window.location.pathname ||
            link.getAttribute("href").charAt(0) === "#" ||
            link.target === "_blank" || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button) return;
        if (!contestSettingsDirty && !contestSettingsSaving) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        afterContestSettingsSaved(function() { window.location.href = link.href; });
    }, true);

    // Preserve the clicked action (especially Commit) when resuming a form.
    var clickedSubmit = null;
    $(document).on("click", ":submit", function() { clickedSubmit = this; });
    document.addEventListener("submit", function(event) {
        var form = event.target;
        if (form.id === "ContestSettingsForm") { event.preventDefault(); return; }
        var button = event.submitter || clickedSubmit;
        clickedSubmit = null;
        if (button && button.form !== form) button = null;
        var discard = button && button.name === "action_<s:ac ac="cnts-forget" />";
        if (!contestSettingsDirty && !contestSettingsSaving) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        afterContestSettingsSaved(function() {
            if (button && button.name) {
                $("<input>").attr({ type: "hidden", name: button.name, value: button.value }).appendTo(form);
            }
            HTMLFormElement.prototype.submit.call(form);
        }, discard);
    }, true);
    $(window).on("beforeunload", function() {
        if (contestSettingsDirty || contestSettingsSaving) return "Settings have not yet been saved to the editing session.";
    });
});
</script>

<div id="ContestAccordion">

    <h3>Basic contest identification</h3>
    <div>

<%#define ORIG_TEXT_ROW
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><label for="ContestSetting_@1"><s:v value="MSG_@1" escape="no" />:</label></td>
        <td><s:textfield id="ContestSetting_@1" size="@3" name="@1" value="cnts->@1" notset="yes" /></td>
        <td><s:help topic="Contest.xml:@1" /></td>
    </s:tr>
#%>

<%#define ORIG_TEXT_ROW_NO_CLEAR
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><label for="ContestSetting_@1"><s:v value="MSG_@1" escape="no" />:</label></td>
        <td><s:textfield id="ContestSetting_@1" size="@2" name="@1" value="cnts->@1" notset="yes" /></td>
        <td><s:help topic="Contest.xml:@1" /></td>
    </s:tr>
#%>

<%#define ORIG_BOOL_ROW
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><label for="ContestSetting_@1"><s:v value="MSG_@1" escape="no" />?</label></td>
        <td><input type="checkbox" id="ContestSetting_@1" name="@1" value="1"<% if (cnts->@1) { %> checked="checked"<% } %> /></td>
        <td><s:help topic="Contest.xml:@1" /></td>
    </s:tr>
#%>

<%#define ORIG_TEXT_ROW_WITH_EDIT
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><label for="ContestSetting_@1"><s:v value="MSG_@1" escape="no" />:</label></td>
        <td><s:textfield id="ContestSetting_@1" size="@3" name="@1" value="cnts->@1" notset="yes" /> <s:a class="contest-file-editor" ac="cnts-edit-@4-page">@5</s:a></td>
        <td><s:help topic="Contest.xml:@1" /></td>
    </s:tr>
#%>

<%#define ORIG_ACCESS_ROW
    <s:tr valign="top" attr="form_row_attrs[row ^= 1]">
        <td>@2</td>
        <td><pre><% super_html_unparse_access_2(out_f, cnts->@1_access); %></pre></td>
        <td><s:a ac="cnts-edit-@1-access-page">Edit</s:a></td>
        <td><s:help topic="Contest.xml:@1_access" /></td>
    </s:tr>
#%>

<%#define ORIG_DATE_TIME_ROW
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><label for="ContestSetting_@1_date"><s:v value="MSG_@1" escape="no" />:</label></td>
        <td><% html_date_select_2(out_f, cnts->@1, "ContestSetting_@1", "@1", NULL, 0, 0, 0); %></td>
        <td><s:help topic="Contest.xml:@1" /></td>
    </s:tr>
#%>

<table border="0" class="contest-settings-section" data-section="basic">
    <s:tr attr="form_row_attrs[row ^= 1]"><td>Contest ID:</td><td><s:v value="cnts->id" /></td><td>&nbsp;</td></s:tr>
    <%@expand ORIG_TEXT_ROW_NO_CLEAR "name" "48" %>
    <%@expand ORIG_TEXT_ROW "name_en" "Basic" "48" %>
    <%@expand ORIG_TEXT_ROW "main_url" "Basic" "48" %>
    <%@expand ORIG_TEXT_ROW "keywords" "Basic" "48" %>
    <%@expand ORIG_TEXT_ROW "comment" "Basic" "48" %>
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><label for="ContestSetting_user_contest"><s:v value="MSG_user_contest" escape="no" />:</label></td>
        <td><select id="ContestSetting_user_contest" name="user_contest"><% fprintf(out_f, "<option value=\"%d\" selected=\"selected\">%d</option>", cnts->user_contest ? atoi((const char *) cnts->user_contest) : 0, cnts->user_contest ? atoi((const char *) cnts->user_contest) : 0); %></select></td>
        <td><s:help topic="Contest.xml:user_contest" /></td>
    </s:tr>
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><label for="ContestSetting_default_locale"><s:v value="MSG_default_locale" escape="no" />:</label></td>
        <td><% l10n_html_locale_select_3(out_f, "ContestSetting_default_locale", NULL, "default_locale", NULL, cnts->default_locale ? l10n_parse_locale(cnts->default_locale) : -1); %></td>
        <td><s:help topic="Contest.xml:default_locale" /></td>
    </s:tr>
    <%@expand ORIG_BOOL_ROW "personal" %>
</table>
    </div>

    <h3>Registration settings</h3>

    <div>
<table border="0" class="contest-settings-section" data-section="registration">
<% row = 1; %>
    <s:tr attr="form_row_attrs[row ^= 1]">
        <td><s:v value="MSG_autoregister" escape="no" />:</td>
        <td><s:yesno id="ContestSetting_autoregister" name="autoregister" value="cnts->autoregister" noLabel="Moderated registration" yesLabel="Free registration" /></td>
        <td><s:help topic="Contest.xml:autoregister" /></td>
    </s:tr>
    <%@expand ORIG_DATE_TIME_ROW "reg_deadline" "Registration" %>
    <%@expand ORIG_TEXT_ROW "register_email" "Registration" "48" %>
    <%@expand ORIG_TEXT_ROW "register_url" "Registration" "48" %>
    <%@expand ORIG_TEXT_ROW "register_subject" "Registration" "48" %>
    <%@expand ORIG_TEXT_ROW "register_subject_en" "Registration" "48" %>
    <%@expand ORIG_TEXT_ROW_WITH_EDIT "register_email_file" "Registration" "48" "register-email-file" "Edit email template" %>
</table>
    </div>

    <h3>Contest timing</h3>

    <div>
<table border="0" class="contest-settings-section" data-section="timing">
<% row = 1; %>
    <%@expand ORIG_DATE_TIME_ROW "sched_time" "Timing" %>
    <%@expand ORIG_DATE_TIME_ROW "open_time" "Timing" %>
    <%@expand ORIG_DATE_TIME_ROW "close_time" "Timing" %>
</table>
    </div>

    <h3>URLs</h3>

    <div>
<table border="0" class="contest-settings-section" data-section="urls">
<% row = 1; %>

    <%@expand ORIG_TEXT_ROW "team_url" "Url" "48" %>
    <%@expand ORIG_TEXT_ROW "standings_url" "Url" "48" %>
    <%@expand ORIG_TEXT_ROW "problems_url" "Url" "48" %>
    <%@expand ORIG_TEXT_ROW "logo_url" "Url" "48" %>
    <%@expand ORIG_TEXT_ROW "css_url" "Url" "48" %>
</table>
    </div>

    <h3>Contest flags</h3>

    <div>
<table border="0" class="contest-settings-section" data-section="flags">
<% row = 1; %>

    <%@expand ORIG_BOOL_ROW "disable_team_password" %>
    <%@expand ORIG_BOOL_ROW "force_password_change" %>
    <%@expand ORIG_BOOL_ROW "simple_registration" %>
    <%@expand ORIG_BOOL_ROW "send_passwd_email" %>

    <%@expand ORIG_BOOL_ROW "clean_users" %>
    <%@expand ORIG_BOOL_ROW "closed" %>
    <%@expand ORIG_BOOL_ROW "invisible" %>
    <%@expand ORIG_BOOL_ROW "disable_member_delete" %>
    <%@expand ORIG_BOOL_ROW "assign_logins" %>
    <%@expand ORIG_BOOL_ROW "force_registration" %>
    <%@expand ORIG_BOOL_ROW "disable_name" %>
    <%@expand ORIG_BOOL_ROW "enable_password_recovery" %>
    <%@expand ORIG_BOOL_ROW "exam_mode" %>
    <%@expand ORIG_BOOL_ROW "disable_password_change" %>
    <%@expand ORIG_BOOL_ROW "disable_locale_change" %>
    <%@expand ORIG_BOOL_ROW "allow_reg_data_edit" %>
    <%@expand ORIG_BOOL_ROW "enable_user_telegram" %>
    <%@expand ORIG_BOOL_ROW "enable_avatar" %>
    <%@expand ORIG_BOOL_ROW "enable_local_pages" %>
    <%@expand ORIG_BOOL_ROW "read_only_name" %>
    <%@expand ORIG_BOOL_ROW "enable_oauth" %>
    <%@expand ORIG_BOOL_ROW "enable_reminders" %>
</table>
    </div>

    <h3>IP-address access restrictions</h3>

    <div>
<table border="0">
<% row = 1; %>

    <%@expand ORIG_ACCESS_ROW "register" "Access to contest registration" %>
    <%@expand ORIG_ACCESS_ROW "users" "Access to user list display" %>
    <%@expand ORIG_ACCESS_ROW "team" "Access to contest participation" %>
    <%@expand ORIG_ACCESS_ROW "master" "Access to contest administration" %>
    <%@expand ORIG_ACCESS_ROW "judge" "Access to contest judging" %>
    <%@expand ORIG_ACCESS_ROW "serve_control" "Access to contest setup" %>
</table>

    </div>

    <h3>User permissions</h3>

    <div>
<table border="0">
<% row = 1; %>

<%
    const struct opcap_list_item *p;
    int i;
    for (i = 0, p = CNTS_FIRST_PERM(cnts); p; ++i, p = CNTS_NEXT_PERM(p)) {
%>
    <s:form>
        <s:hidden name="num" value="i" checkExpr=">= 0" />
        <s:tr valign="top" attr="form_row_attrs[row ^= 1]">
            <td><s:v value="i" />: <s:v value="p->login" /></td>
            <td><font size=\"-2\"><pre><% opcaps_unparse_2(out_f, 0, 32, p->caps); %></pre></font></td>
            <s:url name="EditPermissionsUrl" ac="cnts-edit-permissions-page"><s:param name="num" value="i" /></s:url>
            <td>[<s:a url="EditPermissionsUrl">Edit</s:a>]<s:submit ac="cnts-delete-permission" label="Delete" /></td>
            <td>&nbsp;</td>
         </s:tr>
    </s:form>
<%
    }
%>
    <s:form>
        <s:tr valign="top" attr="form_row_attrs[row ^= 1]">
            <td>Add new user:</td>
            <td>Login: <s:textfield name="param" value="" size="32" /></td>
            <td><s:submit ac="cnts-add-permission" label="Add" /></td>
            <td>&nbsp;</td>
         </s:tr>
    </s:form>

</table>
    </div>

